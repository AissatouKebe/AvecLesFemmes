{% extends 'base.html.twig' %}

{% block title %}Groupements | Avec les femmes{% endblock %}

{% block body %}
<main class="contenu">
    <div class="tete-page">
        <div>
            <h1>Groupements</h1>
            <p class="sous-titre">{{ pagination.total }} groupement{{ pagination.total > 1 ? 's' : '' }} suivi{{ pagination.total > 1 ? 's' : '' }}</p>
        </div>
    </div>
    
        {% for message in app.flashes('success') %}
            <p class="alerte">{{ message }}</p>
        {% endfor %}
        <p><a href="{{ path('app_groupement_new') }}">Nouveau groupement</a></p>

    <section class="panneau" aria-labelledby="titre-liste">
        <div class="filtre" data-ville="{{ filtre.ville }}" data-tel="{{ filtre.tel }}" data-url="{{ path('app_groupement_index') }}">
            <input type="text" id="ville" value="{{ filtre.ville }}" placeholder="Ville">
            <input type="text" id="tel" value="{{ filtre.tel }}" placeholder="Téléphone">
            <button type="button" id="btn-filtrer">Filtrer</button>
        </div>

        <h2 id="titre-liste" class="visuellement-cache">Liste des groupements</h2>

        <div class="defilement">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Groupement</th>
                        <th scope="col">Téléphone</th>
                        <th scope="col">Exercice en cours</th>
                        <th scope="col" class="nombre">Exercices</th>
                        <th scope="col"><span class="visuellement-cache">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                {% for g in groupements %}
                    <tr>
                        <td>
                            <a class="nom-groupement" href="{{ path('app_groupement_show', {id: g.id}) }}">{{ g.nom }}</a>

                            <span class="discret">{{ g.adresse }}</span>
                        </td>
                        <td>{{ g.tel }}</td>
                        <td>
                            {% if g.statutLabel %}
                                <span class="statut statut--{{ g.statutValue }}">{{ g.statutLabel }}</span>
                                <span class="discret">depuis le {{ g.exerciceDebut|date('d/m/Y') }}</span>
                            {% else %}
                                <span class="discret">Aucun exercice en cours</span>
                            {% endif %}
                        </td>
                        <td class="nombre">{{ g.nombreExercices }}</td>
                        <td><a href="{{ path('app_groupement_show', {id: g.id}) }}">Voir la fiche</a></td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucun groupement pour l'instant.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.totalPages > 1 %}
            <nav class="pagination" aria-label="Pagination">
                {% if pagination.numero > 1 %}
                    <a href="{{ path('app_groupement_index', {ville: filtre.ville, tel: filtre.tel, page: pagination.numero - 1}) }}" aria-label="Page précédente">&lt;</a>
                {% else %}
                    <span aria-hidden="true">&lt;</span>
                {% endif %}

                <span>Page {{ pagination.numero }} sur {{ pagination.totalPages }}</span>

                {% if pagination.numero < pagination.totalPages %}
                    <a href="{{ path('app_groupement_index', {ville: filtre.ville, tel: filtre.tel, page: pagination.numero + 1}) }}" aria-label="Page suivante">&gt;</a>
                {% else %}
                    <span aria-hidden="true">&gt;</span>
                {% endif %}
            </nav>
        {% endif %}

        <script>
            (function () {
                const bloc = document.querySelector('.filtre');
                const champVille = document.getElementById('ville');
                const champTel = document.getElementById('tel');

                function filtrer() {
                    const ville = champVille.value.trim();
                    const tel = champTel.value.trim();

                    // même filtre déjà appliqué : un nouvel appui le retire
                    const dejaApplique = (bloc.dataset.ville !== '' || bloc.dataset.tel !== '')
                        && ville === bloc.dataset.ville && tel === bloc.dataset.tel;

                    if (dejaApplique) {
                        window.location.href = bloc.dataset.url;
                        return;
                    }

                    const params = new URLSearchParams();
                    if (ville) params.set('ville', ville);
                    if (tel) params.set('tel', tel);

                    window.location.href = params.toString() ? bloc.dataset.url + '?' + params.toString() : bloc.dataset.url;
                }

                document.getElementById('btn-filtrer').addEventListener('click', filtrer);
                bloc.querySelectorAll('input').forEach(champ => {
                    champ.addEventListener('keydown', e => { if (e.key === 'Enter') filtrer(); });
                });
            })();
        </script>
    </section>
</main>
{% endblock %}
