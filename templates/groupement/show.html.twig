{% extends 'base.html.twig' %}

{% block title %}{{ groupement.nom }} | Avec les femmes{% endblock %}

{% block body %}
{% set exercice = groupement.exerciceEnCours %}
<main class="contenu">
    <a class="retour" href="{{ path('app_groupement_index') }}">Tous les groupements</a>

    <div class="tete-page">
        <div>
            <h1>{{ groupement.nom }}</h1>
            <dl class="coordonnees">
                <div>
                    <dt>Téléphone</dt>
                    <dd>{{ groupement.tel }}</dd>
                </div>
                <div>
                    <dt>Adresse</dt>
                    <dd>{{ groupement.adresse }}</dd>
                </div>
            </dl>
        </div>
    </div>

    {% if exercice %}
        {% set maintenant = date('now') %}
        {% set etapes = [
            {nom: 'Début', date: exercice.dateDebut},
            {nom: 'Date limite des prêts', date: exercice.dateLimitePret},
            {nom: 'Fin', date: exercice.dateFin},
            {nom: 'Rétribution', date: exercice.dateRetribution}

        ] %}
        {% set prochaine = etapes|filter(e => e.date > maintenant)|first %}

        <section class="panneau" aria-labelledby="titre-exercice">
            <div class="entete-panneau">
                <div>
                    <h2 id="titre-exercice">Exercice en cours</h2>
                    <p class="sous-titre">Du {{ exercice.dateDebut|date('d/m/Y') }} au {{ exercice.dateFin|date('d/m/Y') }}</p>
                </div>
            </div>

            <ol class="frise">
                {% for e in etapes %}
                    <li class="etape {% if e.date <= maintenant %}etape--passee{% elseif e == prochaine %}etape--prochaine{% endif %}">
                        <span class="etape__nom">{{ e.nom }}</span>
                        <span class="etape__date">{{ e.date|date('d/m/Y') }}</span>
                        {% if e.nom == 'Date limite des prêts' and e.date > maintenant %}
                            <span class="etape__note">Encore {{ maintenant.diff(e.date).days }} jours pour prêter</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </section>
    {% else %}
        <section class="vide" aria-labelledby="titre-vide">
            <h2 id="titre-vide">Aucun exercice en cours</h2>
            <p>Ce groupement n'a pas d'exercice en cours pour l'instant.</p>
        </section>
    {% endif %}

    {% if groupement.exercices|length > 0 %}
        <section class="panneau" aria-labelledby="titre-historique">

            <div class="entete-panneau">
                <h2 id="titre-historique">Historique des exercices</h2>
            </div>
            <div class="defilement">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Période</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Rétribution</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for e in groupement.exercices %}
                        <tr>
                            <td>{{ e.dateDebut|date('d/m/Y') }} – {{ e.dateFin|date('d/m/Y') }}</td>
                            <td><span class="statut statut--{{ e.statut.value }}">{{ e.statut.label }}</span></td>
                            <td>{{ e.statut.value == 'en_cours' ? 'Prévue le ' : '' }}{{ e.dateRetribution|date('d/m/Y') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
</main>
{% endblock %}